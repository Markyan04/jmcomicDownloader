# scripts/setup.py 会根据当前用户生成 .env。
APP_UID=1000
APP_GID=1000
# 默认保存到项目的 downloads；自定义目录必须预先存在。
# DOWNLOAD_DIR=/path/to/downloads
# JM_SECURE_COOKIE=false
# BIND_ADDRESS=127.0.0.1
# PORT=3011
# Docker Hub 不可达时可选 Docker 官方在 AWS ECR 发布的同款镜像：
# PYTHON_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
# 测试时才设置 JM_MODE=mock；正常使用默认 real。
